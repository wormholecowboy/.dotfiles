{
  "alwaysThinkingEnabled": true,
  "awaySummaryEnabled": false,
  "editorMode": "vim",
  "effortLevel": "high",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false
  },
  "env": {},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/brian.gildea/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "mcpServers": {},
  "model": "claude-fable-5",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(docker cp:*)",
      "Bash(docker exec:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker rm:*)",
      "Bash(docker stop:*)",
      "Bash(docker-compose build:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker-compose ps:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose logs:*)",
      "Bash(find:*)",
      "Bash(gh issue view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run:*)",
      "Bash(npm start)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv sync:*)",
      "Bash(uv pip install:*)",
      "Bash(uv add:*)",
      "Bash(uv pip list:*)",
      "Find(*)",
      "Read(*)",
      "Search(*)",
      "Web Search(*)",
      "mcp__context7"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git reset*--hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.dotfiles/claude/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen"
}
