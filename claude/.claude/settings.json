{
  "env": {
    "AWS_PROFILE": "saml",
    "AWS_REGION": "us-west-2"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(docker cp:*)",
      "Bash(docker exec:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker rm:*)",
      "Bash(docker stop:*)",
      "Bash(docker-compose build:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker-compose ps:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose logs:*)",
      "Bash(find:*)",
      "Bash(gh issue view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run:*)",
      "Bash(npm start)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv sync:*)",
      "Bash(uv pip install:*)",
      "Bash(uv add:*)",
      "Bash(uv pip list:*)",
      "Find(*)",
      "Read(*)",
      "Search(*)",
      "Web Search(*)",
      "mcp__context7"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git reset*--hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(aws athena start-query-execution*CREATE OR REPLACE VIEW*)",
      "Bash(aws athena start-query-execution*create or replace view*)",
      "Bash(aws athena start-query-execution*DROP VIEW*)",
      "Bash(aws athena start-query-execution*drop view*)",
      "Bash(aws athena start-query-execution*DROP TABLE*)",
      "Bash(aws athena start-query-execution*drop table*)",
      "Bash(aws athena start-query-execution*DROP DATABASE*)",
      "Bash(aws athena start-query-execution*drop database*)",
      "Bash(aws athena start-query-execution*DROP SCHEMA*)",
      "Bash(aws athena start-query-execution*drop schema*)",
      "Bash(aws athena start-query-execution*ALTER TABLE*)",
      "Bash(aws athena start-query-execution*alter table*)",
      "Bash(aws athena start-query-execution*ALTER VIEW*)",
      "Bash(aws athena start-query-execution*alter view*)",
      "Bash(aws athena start-query-execution*ALTER DATABASE*)",
      "Bash(aws athena start-query-execution*alter database*)",
      "Bash(aws athena start-query-execution*INSERT INTO*)",
      "Bash(aws athena start-query-execution*insert into*)",
      "Bash(aws athena start-query-execution*UNLOAD*)",
      "Bash(aws athena start-query-execution*unload*)",
      "Bash(aws athena start-query-execution*UPDATE *)",
      "Bash(aws athena start-query-execution*update *)",
      "Bash(aws athena start-query-execution*DELETE FROM*)",
      "Bash(aws athena start-query-execution*delete from*)",
      "Bash(aws athena start-query-execution*MERGE INTO*)",
      "Bash(aws athena start-query-execution*merge into*)",
      "Bash(aws athena start-query-execution*TRUNCATE*)",
      "Bash(aws athena start-query-execution*truncate*)",
      "Bash(aws athena start-query-execution*OPTIMIZE*)",
      "Bash(aws athena start-query-execution*optimize*)",
      "Bash(aws athena start-query-execution*VACUUM*)",
      "Bash(aws athena start-query-execution*vacuum*)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/claude/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "45.76.0.220",
        "vultr"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
